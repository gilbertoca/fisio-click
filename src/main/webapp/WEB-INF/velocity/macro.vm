#**
 * Css menu macro.
 *
 * Iterates Menu#getChildren and uses Menu#getHref, which already
 * includes the context path.
 *
 * Visibility of auth-sensitive items is driven by $authenticated,
 * exposed by BorderPage#onInit().
 *#
#macro(renderMenu $menu)
  #foreach($item in $menu.children)
    #if($authenticated)
      <li>
        #if($item.hasChildren())
          <!-- Submenu via details/summary: padrão que o Bahunya reconhece
               (dropdown por clique, full-width em telas pequenas — o par
               <a>+<ul> aninhado só abria por hover, morto em tela de toque) -->
          <details>
            <summary>$item.label</summary>
            <ul>
              #renderMenu($item)
            </ul>
          </details>
        #else
          <!-- Item de link comum -->
          <a href="$item.href">$item.label</a>
        #end
      </li>
    #end
  #end
#end

#**
 * Botão de criação ("Novo registro") do cabeçalho das listagens: form GET +
 * button nativo do HTML — navega para a página de edição sem JavaScript e
 * sem CSS extra (o Bahunya estiliza o elemento button). Centralizado aqui:
 * qualquer ajuste de markup muda em um lugar só. Uso:
 *   #renderBotaoNovo("cliente-edit.htm" "Novo cliente")
 *#
#macro(renderBotaoNovo $caminho $rotulo)
<div class="painel-acao">
    <form method="get" action="$context/$caminho">
        <button>$rotulo</button>
    </form>
</div>
#end

#**
 * Diálogo de confirmação de exclusão das listagens: <dialog> nativo do HTML
 * (o Bahunya estiliza) + grampo mínimo de JavaScript que intercepta o clique
 * na ActionLink (onDeleteClick, registrado em deleteLink.setAttribute),
 * guarda o href e navega só na confirmação. Centralizado aqui: qualquer
 * ajuste de markup muda em um lugar só. Uso:
 *   #renderDialogExclusao("Tem certeza que quer excluir esse registro? Essa ação não poderá ser desfeita.")
 *#
#macro(renderDialogExclusao $pergunta)
<dialog id="deleteDialog">
    <article>
        <header><strong>Confirme a exclusão</strong></header>
        <p>$pergunta</p>
        <footer>
            <button id="deleteCancel" type="button">Cancelar</button>
            <button id="deleteConfirm" type="button">Excluir</button>
        </footer>
    </article>
</dialog>
<script>
    (function () {
        var dialog = document.getElementById('deleteDialog');
        var pendingHref = null;

        // Intercepta o clique na ActionLink, guarda o href e abre o diálogo.
        window.onDeleteClick = function (link) {
            pendingHref = link.href;
            dialog.showModal();
            return false;
        };

        document.getElementById('deleteCancel').addEventListener('click', function () {
            pendingHref = null;
            dialog.close();
        });

        // Confirmar: navega para a URL original da ActionLink.
        document.getElementById('deleteConfirm').addEventListener('click', function () {
            if (pendingHref) {
                window.location.href = pendingHref;
            }
            dialog.close();
        });
    })();
</script>
#end
